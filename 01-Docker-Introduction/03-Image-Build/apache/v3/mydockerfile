# Base Images 
FROM ubuntu:20.04 

# Update APT-Repo
RUN apt-get update 

# Update Env Variables 
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

RUN apt-get install -y tzdata apache2

#Deploy Index file 
COPY index.html /var/www/html/

#Expose Port 
EXPOSE 80 
EXPOSE 3306 

CMD ["/usr/sbin/apache2ctl","-D","FOREGROUND"] 
